# Copy to .env. Never commit .env.

# Database
POSTGRES_USER=mimer
POSTGRES_PASSWORD=
POSTGRES_DB=valv

# Embeddings + metadata extraction (openrouter.ai/keys).
# Without it nothing gets an embedding, so semantic search is unavailable.
OPENROUTER_API_KEY=

# Bearer key every /mcp and /api call must present.
# Generate: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
MCP_ACCESS_KEY=

# Optional second key, accepted as /mcp?key=<KEY> on the open listener only, for
# clients whose UI takes a URL and no headers - Claude Desktop's connector dialog
# is the reason it exists. Make it a DIFFERENT value from MCP_ACCESS_KEY: a key
# in a URL ends up in the client's saved config and in proxy logs, and this one
# can only ever reach the open tier. Leave empty to disable entirely.
MCP_OPEN_KEY=

# Key for the read-only listener on port 8792. That port serves the open tier
# with no write tools registered at all - search, list, fetch and statistics and
# nothing else - so a model that keeps mangling the memory can still look things
# up. Make it a THIRD, different value: give it the open key instead and the
# same client can simply write on 8791. Leave empty and the port falls back to
# MCP_ACCESS_KEY, which works but cannot be rotated on its own.
MCP_READ_KEY=

# Public base URL used when citing a thought back to a client. Set this to your
# own hostname; it is the only site-specific value the running code needs.
CITATION_BASE_URL=https://brain.example.net/thoughts

# --- The Connect page ---------------------------------------------------------
# PUBLIC_URL is optional and falls back to CITATION_BASE_URL without its path.
PUBLIC_URL=https://brain.example.net

# LAN_URL is normally left empty. The server learns its own LAN address from the
# Host header of visits to the LAN listener - an address a browser demonstrably
# reached it on - and remembers it, so the Connect page can still name it when
# you are reading that page through the proxy. Asking the OS instead would return
# Docker's bridge address, which works for nobody.
# Set this only to override what it learned, e.g. to print a hostname.
LAN_URL=

# --- Statistics ---------------------------------------------------------------
# Where a day and a month break. Left as UTC, "today" would roll over at 01:00 or
# 02:00 local time and an evening memory would land on tomorrow.
STATS_TZ=Europe/Stockholm
# The usage log holds one small row per call and never any content. Pruned daily.
# Only the starting value: the Statistics page sets retention from a dropdown and
# stores the choice in the database, which then wins over this line.
USAGE_RETENTION_DAYS=730

# --- Change log and recall hint ------------------------------------------------
# A deleted memory keeps its text in the change log this many days, so it can be
# restored from the Review page. Afterwards only the record of the delete remains.
CHANGE_LOG_DELETED_DAYS=30
# Semantic floor for the Claude Code recall hook (tools/hooks/). Lower finds more
# and interrupts more; 0.5 kept unrelated prompts out on the live brain.
RECALL_HINT_FLOOR=0.5
# The model that judges whether two memories contradict each other. Empty means
# qwen/qwen3-235b-a22b-2507 on OpenRouter (measured: no false alarms where
# gpt-4o-mini raised nine), or META_MODEL on any other endpoint.
CONTRADICTION_MODEL=

# --- More model providers -----------------------------------------------------
# Each one appears as a choice on the Models card (Connect page, LAN listener
# only) once it has what it needs. Keys stay here; the web UI never sees them.
# Models chosen on the card are stored in the database and win over the
# *_MODEL lines above.
OPENAI_API_KEY=
# Ollama's address, e.g. http://192.0.2.50:11434 (/v1 is added if missing).
OLLAMA_URL=
# Any other OpenAI-compatible server: base URL ending in /v1, optional key.
CUSTOM_AI_URL=
CUSTOM_AI_KEY=
CUSTOM_AI_NAME=

# --- MQTT to Home Assistant ---------------------------------------------------
# Leave MQTT_URL empty to publish nothing at all. With it set, the brain announces
# itself over HA discovery as the device "Mimers Brain" and publishes counters
# plus a last-will availability topic, so a crash shows up as offline rather than
# as numbers that quietly stop changing.
#
# Counters only - no memory content and no search queries ever go on the broker.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PREFIX=mimersbrain
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_INTERVAL_S=60
# Starting value for number.mimers_brain_unreported_fault: how many unreported
# recall traces in 24h count as a fault. The slider in Home Assistant overrides
# this and its choice is kept on the broker, so this only applies the first time.
MQTT_UNREPORTED_FAULT=5
MQTT_CLIENT_ID=
